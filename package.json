{
  "name": "mysticall-soul-video",
  "version": "0.1.0",
  "private": true,
  "description": "Pipeline determinístico de edição de vídeo vertical (TikTok) da Mysticall Soul",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "verificar": "node scripts/verificar.mjs",
    "preparar": "node scripts/preparar.mjs",
    "contato": "node render.mjs --contact-sheet",
    "render": "node render.mjs",
    "preview": "node scripts/preview.mjs",
    "test": "node --test --test-concurrency=1 \"test/unit/*.test.mjs\" \"test/integration/*.test.mjs\"",
    "test:rapido": "node --test \"test/unit/*.test.mjs\""
  },
  "dependencies": {
    "@fontsource/anton": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "playwright": "1.56.1"
  }
}
